{
  "name": "bolo-debate-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend for Bolo Debate audio discussion platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "prisma db push --accept-data-loss && node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/websocket": "^8.3.1",
    "@prisma/client": "^5.7.0",
    "dotenv": "^17.2.4",
    "fastify": "^4.25.0",
    "ioredis": "^5.3.2",
    "livekit-server-sdk": "^2.0.0",
    "node-cron": "^3.0.3",
    "openai": "^4.24.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
