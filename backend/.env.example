# Bolo Debate Backend Environment Variables

# Database (PostgreSQL for production, SQLite for local)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
# For local development with SQLite:
# DATABASE_URL="file:./prisma/dev.db"

# Redis (for caching and pub/sub)
REDIS_URL="redis://localhost:6379"
# For local development without Redis:
# REDIS_URL="memory"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# LiveKit (Real-time Audio)
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_URL="wss://your-livekit-server.fly.dev"

# AI Providers (in priority order: Groq > Ollama > OpenAI)
# Groq - FREE tier with fast inference (RECOMMENDED)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your-groq-api-key"

# Ollama - Self-hosted option (for running locally)
# Install: https://ollama.com/download
# Then run: ollama pull qwen2.5:7b (good multilingual support)
OLLAMA_URL="http://localhost:11434"

# OpenAI - Paid option (only used if Groq/Ollama unavailable)
OPENAI_API_KEY="sk-your-openai-api-key"

# Server Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
