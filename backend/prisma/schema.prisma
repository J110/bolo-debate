// Prisma Schema for Bolo Debate
// Production: PostgreSQL | Local: SQLite (use schema.sqlite.prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  username    String   @unique
  displayName String
  avatarUrl   String?
  regionId    String?  @db.Uuid
  isBanned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region             Region?            @relation(fields: [regionId], references: [id])
  hostedRooms        Room[]             @relation("HostedRooms")
  participations     RoomParticipant[]
  messages           Message[]
  reactions          Reaction[]
  reportsMade        Report[]           @relation("ReportsMade")
  reportsReceived    Report[]           @relation("ReportsReceived")
  friendshipsInitiated Friendship[]     @relation("FriendshipsInitiated")
  friendshipsReceived  Friendship[]     @relation("FriendshipsReceived")
  categoryPreferences  UserCategoryPreference[]

  @@index([username])
  @@index([regionId])
}

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  users User[]
  rooms Room[]

  @@unique([name, state])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  icon      String
  color     String
  createdAt DateTime @default(now())

  rooms       Room[]
  newsSources NewsSource[]
  userPreferences UserCategoryPreference[]
}

model UserCategoryPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

enum RoomType {
  DEBATE
  DISCUSSION
  AMA
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ParticipantSide {
  A
  B
  NEUTRAL
}

enum ParticipantRole {
  HOST
  SPEAKER
  LISTENER
}

model Room {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  hostId         String?    @db.Uuid
  regionId       String     @db.Uuid
  categoryId     String     @db.Uuid
  type           RoomType   @default(DEBATE)
  sideALabel     String?
  sideBLabel     String?
  scheduledAt    DateTime
  startedAt      DateTime?
  endsAt         DateTime?
  extensionsUsed Int        @default(0)
  status         RoomStatus @default(SCHEDULED)
  isAiHosted     Boolean    @default(false)
  aiSuggestions  Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  host         User?             @relation("HostedRooms", fields: [hostId], references: [id])
  region       Region            @relation(fields: [regionId], references: [id])
  category     Category          @relation(fields: [categoryId], references: [id])
  participants RoomParticipant[]
  messages     Message[]
  reactions    Reaction[]
  reports      Report[]

  @@index([status])
  @@index([regionId])
  @@index([categoryId])
  @@index([scheduledAt])
}

model RoomParticipant {
  id         String          @id @default(uuid()) @db.Uuid
  roomId     String          @db.Uuid
  userId     String          @db.Uuid
  side       ParticipantSide @default(NEUTRAL)
  role       ParticipantRole @default(LISTENER)
  handRaised Boolean         @default(false)
  isMuted    Boolean         @default(true)
  joinedAt   DateTime        @default(now())
  leftAt     DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String       @db.Uuid
  roomId         String?      @db.Uuid
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User  @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  room         Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Friendship {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  friendId  String           @db.Uuid
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User @relation("FriendshipsInitiated", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipsReceived", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model NewsSource {
  id           String   @id @default(uuid()) @db.Uuid
  regionId     String?  @db.Uuid
  categoryId   String?  @db.Uuid
  headline     String
  summary      String?
  sourceUrl    String?
  fetchedAt    DateTime @default(now())
  usedForTopic Boolean  @default(false)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([fetchedAt])
}
