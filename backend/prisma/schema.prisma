// Prisma Schema for Bolo Debate
// Production: PostgreSQL | Local: SQLite (use schema.sqlite.prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  username    String   @unique
  displayName String
  avatarUrl   String?
  regionId    String?  @db.Uuid
  isBanned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region             Region?            @relation(fields: [regionId], references: [id])
  hostedRooms        Room[]             @relation("HostedRooms")
  participations     RoomParticipant[]
  messages           Message[]
  reactions          Reaction[]
  reportsMade        Report[]           @relation("ReportsMade")
  reportsReceived    Report[]           @relation("ReportsReceived")
  friendshipsInitiated Friendship[]     @relation("FriendshipsInitiated")
  friendshipsReceived  Friendship[]     @relation("FriendshipsReceived")
  categoryPreferences  UserCategoryPreference[]

  @@index([username])
  @@index([regionId])
}

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  users User[]
  rooms Room[]

  @@unique([name, state])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  icon      String
  color     String
  createdAt DateTime @default(now())

  rooms          Room[]
  newsSources    NewsSource[]
  trendingItems  TrendingItem[]
  userPreferences UserCategoryPreference[]
}

model UserCategoryPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

enum RoomType {
  DEBATE
  DISCUSSION
  AMA
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ParticipantSide {
  A
  B
  NEUTRAL
}

// Topic type for categorizing source of topics
enum TopicType {
  TRENDING      // From news/RSS feeds (local/national)
  GENERIC       // Evergreen debate topics
  INTERNATIONAL // Global topics interesting to Indian audience
}

enum ParticipantRole {
  HOST
  SPEAKER
  LISTENER
}

model Room {
  id              String     @id @default(uuid()) @db.Uuid
  title           String
  originalTitle   String?    // Original English title (before translation) for duplicate checking
  description     String?
  hostId          String?    @db.Uuid
  regionId        String     @db.Uuid
  categoryId      String     @db.Uuid
  type            RoomType   @default(DEBATE)
  topicType       TopicType? // TRENDING, GENERIC, or INTERNATIONAL for ratio tracking
  sideALabel      String?
  sideBLabel      String?
  language        String     @default("English")  // Discussion language (English, Hindi, Tamil, etc.)
  illustrationUrl String?    // Pixabay illustration URL fetched from English title before translation
  scheduledAt     DateTime
  startedAt       DateTime?
  endsAt          DateTime?
  extensionsUsed  Int        @default(0)
  status          RoomStatus @default(SCHEDULED)
  isAiHosted      Boolean    @default(false)
  aiSuggestions   Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  host         User?             @relation("HostedRooms", fields: [hostId], references: [id])
  region       Region            @relation(fields: [regionId], references: [id])
  category     Category          @relation(fields: [categoryId], references: [id])
  participants RoomParticipant[]
  messages     Message[]
  reactions    Reaction[]
  reports      Report[]

  @@index([status])
  @@index([regionId])
  @@index([categoryId])
  @@index([scheduledAt])
  @@index([topicType])
}

model RoomParticipant {
  id         String          @id @default(uuid()) @db.Uuid
  roomId     String          @db.Uuid
  userId     String          @db.Uuid
  side       ParticipantSide @default(NEUTRAL)
  role       ParticipantRole @default(LISTENER)
  handRaised Boolean         @default(false)
  isMuted    Boolean         @default(true)
  joinedAt   DateTime        @default(now())
  leftAt     DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String       @db.Uuid
  roomId         String?      @db.Uuid
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User  @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  room         Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Friendship {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  friendId  String           @db.Uuid
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User @relation("FriendshipsInitiated", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipsReceived", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

// Raw trending data fetched from news/RSS sources
model TrendingItem {
  id            String   @id @default(uuid()) @db.Uuid
  regionId      String?  @db.Uuid
  categoryId    String?  @db.Uuid
  headline      String
  summary       String?
  sourceUrl     String?
  sourceName    String?           // e.g., "Times of India", "NDTV"
  publishedAt   DateTime?         // When the news was published
  fetchedAt     DateTime @default(now())
  trendingScore Float    @default(1.0)  // Higher = more trending
  isProcessed   Boolean  @default(false) // Has this been converted to a topic?
  expiresAt     DateTime          // When this trending item expires

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([regionId])
  @@index([categoryId])
  @@index([fetchedAt])
  @@index([expiresAt])
  @@index([isProcessed])
}

// Legacy - kept for backward compatibility
model NewsSource {
  id           String   @id @default(uuid()) @db.Uuid
  regionId     String?  @db.Uuid
  categoryId   String?  @db.Uuid
  headline     String
  summary      String?
  sourceUrl    String?
  fetchedAt    DateTime @default(now())
  usedForTopic Boolean  @default(false)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([fetchedAt])
}

// Debate topics generated from trending content or predefined
model TopicQueue {
  id             String    @id @default(uuid()) @db.Uuid
  categoryId     String    @db.Uuid
  title          String
  description    String?
  sideALabel     String
  sideBLabel     String
  subtopics      Json?
  
  // Topic classification
  topicType      TopicType @default(TRENDING)  // TRENDING, GENERIC, or INTERNATIONAL
  regionTags     String[]  @default([])        // Region tags (e.g., ["Mumbai", "National", "International"])
  language       String    @default("English") // Topic language (English or Hindi)
  
  // Legacy field - kept for backward compatibility during migration
  regionId       String?   @db.Uuid
  
  // Source tracking
  sourceHeadline String?           // Original news headline that inspired this topic
  sourceUrl      String?           // Link to original source
  
  // Lifecycle management
  trendingScore  Float     @default(1.0)  // Priority score (higher = use first)
  isUsed         Boolean   @default(false)
  usageCount     Int       @default(0)    // How many times this topic has been used
  maxUsages      Int       @default(3)    // Max times a topic can be used before expiring
  
  // Timestamps
  createdAt      DateTime  @default(now())
  usedAt         DateTime?
  expiresAt      DateTime?         // Hard expiry - topic won't be used after this
  lastRefreshedAt DateTime @default(now()) // Last time trending score was updated

  @@index([categoryId, isUsed])
  @@index([topicType])
  @@index([language])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([trendingScore])
}

// Track used topics for 3-month duplicate prevention
model UsedTopic {
  id            String   @id @default(uuid()) @db.Uuid
  titleHash     String   @unique  // SHA256 hash of normalized title
  originalTitle String            // Original title for debugging
  categoryId    String   @db.Uuid
  topicType     TopicType
  language      String   @default("English")
  usedAt        DateTime @default(now())
  expiresAt     DateTime          // usedAt + 3 months - auto cleanup after this

  @@index([categoryId])
  @@index([expiresAt])
  @@index([usedAt])
}
