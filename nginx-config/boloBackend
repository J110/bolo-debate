server {
    listen 80;
    server_name bolo-backend-prod.vervetogether.com;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name bolo-backend-prod.vervetogether.com;

    client_max_body_size 10M;

    ssl_certificate /etc/letsencrypt/live/vervetogether.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vervetogether.com/privkey.pem;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    location / {
        proxy_pass http://localhost:3009;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    # Serve the privacy page under /legal/
    location /legal/ {
      root /var/www/html;
      index bolo_privacy.html;
    }

}
